enum DeliveryStatus {
  PENDING_PAYMENT
  PENDING_PHOTO_UPLOAD
  PHOTO_WAITING_BUYER_CONFIRMATION
  PHOTO_CONFIRMED_BY_BUYER
  PICKUP_ISSUED
  IN_TRANSIT
  DELIVERY_PHOTO_UPLOADED
  AWAITING_RECEIPT
  RECEIPT_OTP_ISSUED
  AWAITING_RELEASE_WINDOW
  PAYMENT_PROCESSING
  COMPLETED
  DISPUTED
  REFUNDED
  PAYMENT_FAILED
  DELIVERY_TIMEOUT
  DELIVERY_OVERDUE
  AUTO_REFUNDED
}

enum DeliveryPhotoType {
  BEFORE
  DURING
  AFTER
}

enum DeliveryOTPType {
  PICKUP
  DELIVERY
}

enum DeliveryActorType {
  BUYER
  DELIVERY_GUY
  SYSTEM
  ADMIN
}

enum DeliveryDisputeStatus {
  OPEN
  PENDING_ADMIN
  AUTO_RESOLVED
  RESOLVED
  ESCALATED
}

enum DeliveryRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model DeliveryMpesaTransaction {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkoutRequestId String        @unique
  merchantRequestId String?
  amount            Decimal       @db.Decimal(10, 2)
  fee               Decimal       @db.Decimal(10, 2)
  totalCharged      Decimal       @db.Decimal(10, 2)
  phone             String
  status            String        @default("pending")
  mpesaRef          String?       @unique
  resultDesc        String?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model DeliveryEscrow {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(10, 2)
  status     String        @default("held")
  heldAt     DateTime
  releasedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model DeliveryMpesaCallback {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([type])
}

// ═══════════════════════════════════════════
// HOUSE ESCROW SYSTEM
// ═══════════════════════════════════════════
model HouseEscrow {
  id                 String            @id @default(cuid())
  buyerId            String
  sellerPhone        String
  buyerPhone         String?
  description        String
  serviceType        String            @default("general")
  address            String?
  amount             Decimal           @db.Decimal(10, 2)
  platformFee        Decimal?          @db.Decimal(10, 2)
  sellerReceives     Decimal?          @db.Decimal(10, 2)
  status             HouseEscrowStatus @default(PENDING_ACCEPTANCE)
  acceptanceDeadline DateTime?
  mpesaCheckoutId    String?           @unique
  mpesaRef           String?           @unique
  idempotencyKey     String?           @unique
  inspectionHours    Int               @default(24)
  inspectionDeadline DateTime?
  completedAt        DateTime?
  autoReleasedAt     DateTime?

  buyer         User                   @relation("BuyerHouseEscrows", fields: [buyerId], references: [id])
  dispute       HouseDispute?
  mpesaTx       HouseMpesaTransaction?
  auditLogs     HouseAuditLog[]
  notifications Notification[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([buyerId])
  @@index([inspectionDeadline])
  @@index([acceptanceDeadline])
}

model HouseDispute {
  id          String              @id @default(cuid())
  escrowId    String              @unique
  openedBy    String
  reason      String
  purpose     TransferPurpose     @default(OTHER)
  description String?
  buyerPhotos String[]
  adminNotes  String?
  decision    HouseDisputeResult?
  status      HouseDisputeStatus  @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())

  escrow HouseEscrow @relation(fields: [escrowId], references: [id])
}

model HouseMpesaTransaction {
  id                String    @id @default(cuid())
  escrowId          String    @unique
  checkoutRequestId String    @unique
  merchantRequestId String?
  amount            Decimal   @db.Decimal(10, 2)
  fee               Decimal?  @db.Decimal(10, 2)
  phone             String
  status            String    @default("pending")
  mpesaRef          String?   @unique
  idempotencyKey    String?   @unique
  resultDesc        String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  escrow HouseEscrow @relation(fields: [escrowId], references: [id])
}

model HouseAuditLog {
  id        String   @id @default(cuid())
  escrowId  String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  escrow HouseEscrow? @relation(fields: [escrowId], references: [id], onDelete: SetNull)
}

enum HouseEscrowStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  EXPIRED
  PENDING_PAYMENT
  PAYMENT_INITIATING
  PAYMENT_HELD
  CONFIRMED
  DISPUTED
  ESCALATED
  REFUNDED
  COMPLETED
  AUTO_RELEASED
  CANCELLED
}

enum HouseDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

enum HouseDisputeResult {
  FULL_REFUND
  FULL_RELEASE
  PARTIAL
}

enum CustomEscrowStatus {
  PENDING_ACCEPTANCE
  REJECTED
  ACCEPTED
  PENDING_PAYMENT
  PAYMENT_INITIATING
  PAYMENT_HELD
  BUYER_CONFIRMED
  COMPLETED
  DISPUTED
  PAYMENT_MISMATCH
  RELEASING_FUNDS
  REFUNDED
  CANCELLED
}

model CustomEscrow {
  id                      String                   @id @default(cuid())
  buyerId                 String
  buyer                   User                     @relation("CustomBuyer", fields: [buyerId], references: [id])
  counterpartyPhone       String
  title                   String
  description             String
  amount                  Decimal                  @db.Decimal(12, 2)
  platformFee             Decimal                  @db.Decimal(12, 2)
  counterpartyReceives    Decimal                  @db.Decimal(12, 2)
  b2cCost                 Decimal?                 @db.Decimal(12, 2)
  buyerTotal              Decimal?                 @db.Decimal(12, 2)
  isRisky                 Boolean                  @default(false)
  riskDescription         String?
  riskPhotos              String[]
  additionalNotes         String?
  completionHours         Int?
  deadline                DateTime?
  status                  CustomEscrowStatus       @default(PENDING_ACCEPTANCE)
  mpesaCheckoutId         String?                  @unique
  mpesaRef                String?
  buyerConfirmedAt        DateTime?
  counterpartyConfirmedAt DateTime?
  completedAt             DateTime?
  payoutQueuedAt          DateTime?
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  mpesaTransactions       CustomMpesaTransaction[]
  dispute                 CustomDispute?
  auditLogs               CustomAuditLog[]
  b2cTransactions         CustomB2CTransaction[]
}

model CustomMpesaTransaction {
  id                String       @id @default(cuid())
  escrowId          String
  escrow            CustomEscrow @relation(fields: [escrowId], references: [id])
  checkoutRequestId String       @unique
  merchantRequestId String?
  amount            Decimal      @db.Decimal(12, 2)
  fee               Decimal      @default(0) @db.Decimal(12, 2)
  phone             String
  status            String       @default("pending")
  idempotencyKey    String       @unique
  mpesaRef          String?
  resultDesc        String?
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
}

model CustomDispute {
  id             String       @id @default(cuid())
  escrowId       String       @unique
  escrow         CustomEscrow @relation(fields: [escrowId], references: [id])
  openedBy       String
  openedByRole   String
  reason         String
  description    String
  evidence       String[]
  sellerResponse String?
  sellerEvidence String[]
  status         String       @default("OPEN")
  resolution     String?
  buyerAmount    Decimal?     @db.Decimal(12, 2)
  sellerAmount   Decimal?     @db.Decimal(12, 2)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CustomB2CTransaction {
  id                       String       @id @default(cuid())
  escrowId                 String
  escrow                   CustomEscrow @relation(fields: [escrowId], references: [id])
  type                     String // 'payout' | 'refund'
  originatorConversationId String       @unique
  amount                   Decimal      @db.Decimal(12, 2)
  phone                    String
  status                   String       @default("pending") // pending | confirmed | failed
  mpesaRef                 String?
  resultCode               String?
  resultDesc               String?
  confirmedAt              DateTime?
  createdAt                DateTime     @default(now())

  @@index([escrowId])
  @@index([status])
  @@index([originatorConversationId])
}

model CustomAuditLog {
  id        String       @id @default(cuid())
  escrowId  String
  escrow    CustomEscrow @relation(fields: [escrowId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime     @default(now())
}

// ═══════════════════════════════════════════
// LINK-BOUND ORDER ESCROW (standalone service)
// ═══════════════════════════════════════════
enum OrderState {
  HELD
  RELEASED
  DISPUTED
  RESOLVED_BUYER
  RESOLVED_SELLER
  AUTO_RELEASED
}

model Order {
  id             String     @id @default(cuid())
  reference      String     @unique
  buyerId        String
  sellerPhone    String
  service        String
  area           String
  amount         Decimal    @db.Decimal(10, 2)
  platformFee    Decimal?   @db.Decimal(10, 2)
  sellerReceives Decimal?   @db.Decimal(10, 2)
  buyerTotal     Decimal?   @db.Decimal(10, 2)
  timerMinutes   Int
  state          OrderState @default(HELD)
  expiresAt      DateTime?
  linkOpenedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  buyer         User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  events        OrderEvent[]
  dispute       OrderDispute?
  linkSessions  LinkSession[]
  notifications Notification[]

  @@index([state])
  @@index([buyerId])
  @@index([reference])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  action    String
  actor     String
  metadata  Json?
  timestamp DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderDispute {
  id                String    @id @default(cuid())
  orderId           String    @unique
  reason            String
  buyerNote         String?
  sellerEvidenceUrl String?
  sellerNote        String?
  resolvedBy        String?
  resolution        String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

model LinkSession {
  id                String   @id @default(cuid())
  orderId           String
  ip                String?
  deviceFingerprint String?
  openedAt          DateTime @default(now())
  actionTaken       String?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ── Protected Transfer ───────────────────────────────────────────────────────

model ProtectedTransfer {
  id             String                 @id @default(uuid())
  senderId       String
  sender         User                   @relation("SentTransfers", fields: [senderId], references: [id])
  recipientPhone String
  recipientId    String?
  recipient      User?                  @relation("ReceivedTransfers", fields: [recipientId], references: [id])
  amount         Decimal                @db.Decimal(10, 2)
  platformFee    Decimal                @db.Decimal(10, 2)
  b2cCharge      Decimal                @db.Decimal(10, 2)
  purpose        TransferPurpose        @default(OTHER)
  description    String
  state          ProtectedTransferState @default(PENDING)
  mpesaRef       String?
  b2cRef         String?
  stkCheckoutId  String?                @unique
  claimCode      String                 @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  declinedAt     DateTime?
  cancelledAt    DateTime?
  expiredAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

enum TransferPurpose {
  RENT
  PURCHASE
  SALARY
  SCHOOL_FEES
  LOAN
  GIFT
  OTHER
}

enum ProtectedTransferState {
  PENDING
  RELEASING
  REFUNDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

model RequestMoney {
  id                String         @id @default(uuid())
  requesterId       String
  recipientPhone    String
  recipientId       String?
  amount            Decimal        @db.Decimal(12, 2) // what requester receives
  platformFee       Decimal        @db.Decimal(10, 2) // LipaSafe keeps this
  b2cCost           Decimal        @default(0) @db.Decimal(10, 2) // Safaricom B2C charge passed to recipient
  recipientPays     Decimal        @db.Decimal(12, 2) // STK push amount (amount + platformFee + b2cCost)
  purpose           RequestPurpose
  note              String?
  state             RequestState   @default(PENDING)
  expiresAt         DateTime
  checkoutRequestId String?        @unique // set when STK is initiated
  mpesaRef          String? // set after STK success callback
  b2cRef            String? // set after B2C payout confirmed
  b2cStatus         String? // pending, confirmed, failed
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  requester         User           @relation("RequesterRequests", fields: [requesterId], references: [id])
  recipient         User?          @relation("RecipientRequests", fields: [recipientId], references: [id])

  @@index([requesterId])
  @@index([recipientPhone])
  @@index([state])
}

enum RequestPurpose {
  RENT
  SALARY
  SCHOOL_FEES
  PURCHASE
  LOAN
  GIFT
  OTHER
}

enum RequestState {
  PENDING
  PAID
  REJECTED
  CANCELLED
  EXPIRED
}

model StkPushLog {
  id         String   @id @default(cuid())
  checkoutId String   @unique
  context    Json
  createdAt  DateTime @default(now())
}

model FundiExtensionRequest {
  id             String                 @id @default(uuid())
  jobId          String
  requestedBy    String
  extraHours     Int
  reason         String
  evidencePhotos String[]
  status         ExtensionRequestStatus @default(PENDING)
  respondedAt    DateTime?
  createdAt      DateTime               @default(now())
  job            FundiJob               @relation(fields: [jobId], references: [id])
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
