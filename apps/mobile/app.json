{
  "expo": {
    "name": "LipaSafe",
    "slug": "lipasafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00C170"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00C170"
      },
      "package": "com.vezoro.lipasafe",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "LipaSafe",
      "shortName": "LipaSafe",
      "description": "Kenya secure escrow payment app. Lipa Salama. Daima.",
      "backgroundColor": "#00C170",
      "themeColor": "#00C170",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "017f866d-4cfa-4e6c-a395-6430e4e83602"
      }
    },
    "owner": "smartkidnyankore"
  }
}