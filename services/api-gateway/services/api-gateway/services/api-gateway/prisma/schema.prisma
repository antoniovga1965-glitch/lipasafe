generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String              @id @default(uuid())
  phone                 String              @unique
  fullName              String
  pinHash               String
  deviceId              String?
  kycStatus             KycStatus           @default(unverified)
  role                  Role                @default(buyer)
  accountStatus         AccountStatus       @default(active)
  reputationScore       Decimal             @default(100.00) @db.Decimal(5, 2)
  totalTransactions     Int                 @default(0)
  totalDisputed         Int                 @default(0)
  totalCompleted        Int                 @default(0)
  simLastChanged        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  lastLogin             DateTime?
  email                 String              @unique
  pushToken             String?
  avatarUrl             String?
  kycTier               String              @default("basic")
  auditLogs             AuditLog[]
  customEscrowsAsBuyer  CustomEscrow[]      @relation("CustomBuyer")
  buyerDeliveries       DeliveryOrder[]     @relation("BuyerDeliveries")
  diasporaDeals         DiasporaDeal[]
  disputesOpened        Dispute[]           @relation("DisputeOpener")
  disputesResolved      Dispute[]           @relation("DisputeResolver")
  fraudSignals          FraudSignal[]
  fundiAuditLogs        FundiAuditLog[]
  fundiDisputesOpened   FundiDispute[]      @relation("FundiDisputeOpener")
  fundiJobsBuyer        FundiJob[]          @relation("BuyerFundiJobs")
  houseEscrows          HouseEscrow[]       @relation("BuyerHouseEscrows")
  kycPayments           KycPayment[]
  mpesaTransactions     MpesaTransaction[]
  notifications         Notification[]
  orders                Order[]             @relation("BuyerOrders")
  paymentRequests       PaymentRequest[]
  receivedTransfers     ProtectedTransfer[] @relation("ReceivedTransfers")
  sentTransfers         ProtectedTransfer[] @relation("SentTransfers")
  receivedMoneyRequests RequestMoney[]      @relation("RecipientRequests")
  sentMoneyRequests     RequestMoney[]      @relation("RequesterRequests")
  listings              SecondHandListing[]
  sellerProfile         SellerProfile?
  buyerTransactions     Transaction[]       @relation("BuyerTransactions")
  sellerTransactions    Transaction[]       @relation("SellerTransactions")
  wallet                Wallet?
  disputeMessages       DisputeMessage[]
}

model SellerProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  businessName       String?
  category           Category
  idNumber           String?
  idDocUrl           String?
  faceVerified       Boolean   @default(false)
  tillNumber         String?
  transactionLimit   Decimal   @default(500.00) @db.Decimal(10, 2)
  rating             Decimal   @default(5.00) @db.Decimal(3, 2)
  totalEarned        Decimal   @default(0.00) @db.Decimal(12, 2)
  isActive           Boolean   @default(true)
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  status             String    @default("active")
  idBackUrl          String?
  kycRejectionReason String?
  kycSubmittedAt     DateTime?
  selfieUrl          String?
  trustedAt          DateTime?
  trustedSeller      Boolean   @default(false)
  contactNumber      String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycPayment {
  id                String    @id @default(cuid())
  userId            String
  tier              String
  amount            Decimal   @db.Decimal(10, 2)
  phone             String
  status            String    @default("pending")
  checkoutRequestId String?   @unique
  merchantRequestId String?
  mpesaRef          String?
  idempotencyKey    String    @unique
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id                String              @id @default(uuid())
  userId            String              @unique
  availableBalance  Decimal             @default(0.00) @db.Decimal(12, 2)
  escrowBalance     Decimal             @default(0.00) @db.Decimal(12, 2)
  pendingBalance    Decimal             @default(0.00) @db.Decimal(12, 2)
  totalIn           Decimal             @default(0.00) @db.Decimal(12, 2)
  totalOut          Decimal             @default(0.00) @db.Decimal(12, 2)
  currency          String              @default("KES")
  lastUpdated       DateTime            @default(now())
  claimedAt         DateTime?
  isGhost           Boolean             @default(false)
  recallAt          DateTime?
  dailySendDate     DateTime?
  dailySendTotal    Decimal             @default(0.00) @db.Decimal(12, 2)
  recallStartedAt   DateTime?
  recallCompletedAt DateTime?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionsOut   WalletTransaction[] @relation("WalletOut")
  transactionsIn    WalletTransaction[] @relation("WalletIn")
}

model Milestone {
  id              String         @id @default(uuid())
  transactionId   String
  milestoneNumber Int
  description     String?
  amount          Decimal        @db.Decimal(10, 2)
  state           MilestoneState @default(pending)
  deadline        DateTime?
  proofUrl        String?
  completedAt     DateTime?
  releasedAt      DateTime?
  createdAt       DateTime       @default(now())
  transaction     Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Dispute {
  id               String            @id @default(uuid())
  transactionId    String
  openedBy         String
  reason           DisputeReason
  description      String?
  buyerEvidence    Json?
  sellerEvidence   Json?
  status           DisputeStatus     @default(open)
  resolvedBy       String?
  resolutionNote   String?
  resolutionAction ResolutionAction?
  openedAt         DateTime          @default(now())
  resolvedAt       DateTime?
  responseDeadline DateTime?
  opener           User              @relation("DisputeOpener", fields: [openedBy], references: [id])
  resolver         User?             @relation("DisputeResolver", fields: [resolvedBy], references: [id])
  transaction      Transaction       @relation(fields: [transactionId], references: [id])
}

model Notification {
  id              String              @id @default(uuid())
  userId          String
  transactionId   String?
  type            NotificationType
  channel         NotificationChannel
  messageEn       String?
  messageSw       String?
  status          NotificationStatus  @default(pending)
  sentAt          DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())
  houseEscrowId   String?
  orderId         String?
  transferId      String?
  requestId       String?
  deliveryOrderId String?
  customEscrowId  String?
  fundiJobId      String?
  diasporaDealId  String?
  deliveryOrder   DeliveryOrder?      @relation(fields: [deliveryOrderId], references: [id])
  diasporaDeal    DiasporaDeal?       @relation(fields: [diasporaDealId], references: [id])
  fundiJob        FundiJob?           @relation(fields: [fundiJobId], references: [id])
  houseEscrow     HouseEscrow?        @relation(fields: [houseEscrowId], references: [id])
  order           Order?              @relation(fields: [orderId], references: [id])
  transaction     Transaction?        @relation(fields: [transactionId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model FraudSignal {
  id            String       @id @default(uuid())
  userId        String?
  transactionId String?
  signalType    SignalType
  severity      Severity
  scoreImpact   Int
  details       Json?
  actionTaken   SignalAction
  createdAt     DateTime     @default(now())
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            String       @id @default(uuid())
  timestamp     DateTime     @default(now())
  actorId       String?
  actorType     ActorType
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  amount        Decimal?     @db.Decimal(10, 2)
  ipAddress     String?
  deviceId      String?
  metadata      Json?
  transactionId String?
  actor         User?        @relation(fields: [actorId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

model TimerJob {
  id            String         @id @default(uuid())
  transactionId String
  jobType       TimerJobType
  scheduledAt   DateTime
  firedAt       DateTime?
  status        TimerJobStatus @default(pending)
  retryCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, jobType])
}

model WalletTransaction {
  id           String         @id @default(uuid())
  fromWalletId String?
  toWalletId   String?
  amount       Decimal        @db.Decimal(12, 2)
  type         WalletTxType
  reference    String         @unique
  note         String?
  createdAt    DateTime       @default(now())
  clientRef    String?        @unique
  status       WalletTxStatus @default(completed)
  fee          Decimal?       @db.Decimal(12, 2)
  deletedAt    DateTime?
  fromWallet   Wallet?        @relation("WalletOut", fields: [fromWalletId], references: [id])
  toWallet     Wallet?        @relation("WalletIn", fields: [toWalletId], references: [id])

  @@index([fromWalletId, createdAt])
}

model MpesaTransaction {
  id                String    @id @default(uuid())
  userId            String
  checkoutRequestId String    @unique
  amount            Decimal   @db.Decimal(12, 2)
  phone             String
  status            String    @default("pending")
  mpesaRef          String?   @unique
  createdAt         DateTime  @default(now())
  callbackPhone     String?
  idempotencyKey    String?   @unique
  merchantRequestId String?
  processedAt       DateTime?
  resultDesc        String?
  fee               Decimal?  @db.Decimal(10, 2)
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model PaymentRequest {
  id          String    @id @default(uuid())
  requesterId String
  senderPhone String
  amount      Decimal   @db.Decimal(10, 2)
  fee         Decimal?  @db.Decimal(10, 2)
  status      String    @default("pending")
  reference   String    @unique
  note        String?
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  requester   User      @relation(fields: [requesterId], references: [id])
}

model Payout {
  id                       String      @id @default(uuid())
  transactionId            String
  amount                   Decimal     @db.Decimal(10, 2)
  phone                    String
  status                   String      @default("pending")
  originatorConversationId String      @unique
  conversationId           String?
  mpesaRef                 String?
  resultCode               Int?
  resultDesc               String?
  initiatedAt              DateTime    @default(now())
  completedAt              DateTime?
  failedAt                 DateTime?
  createdAt                DateTime    @default(now())
  payoutType               String      @default("full")
  payoutChannel            String?
  payoutDestination        String?
  transaction              Transaction @relation(fields: [transactionId], references: [id])

  @@unique([transactionId, payoutType])
}

model SecondHandListing {
  id              String        @id @default(uuid())
  sellerId        String
  title           String
  condition       ItemCondition
  price           Decimal       @db.Decimal(10, 2)
  description     String?
  brand           String?
  model           String?
  serialNumber    String?
  images          String[]
  conditionPhotos String[]
  status          ListingStatus @default(active)
  lockedAt        DateTime?
  soldAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  seller          User          @relation(fields: [sellerId], references: [id])
  transactions    Transaction[]
}

model Transaction {
  id                   String             @id @default(uuid())
  referenceNo          String             @unique
  buyerId              String
  sellerId             String
  amount               Decimal            @db.Decimal(10, 2)
  platformFee          Decimal?           @db.Decimal(10, 2)
  sellerReceives       Decimal?           @db.Decimal(10, 2)
  category             Category
  description          String?
  state                TransactionState   @default(initiated)
  mpesaCheckoutId      String?
  mpesaReceipt         String?
  buyerPhone           String?
  sellerTill           String?
  paymentDeadline      DateTime?
  deliveryDeadline     DateTime?
  confirmationDeadline DateTime?
  autoReleaseAt        DateTime?
  deliveryProofUrl     String?
  deliveryNotes        String?
  fraudScore           Int?
  fraudFlags           Json?
  hasMilestones        Boolean            @default(false)
  totalMilestones      Int                @default(0)
  completedMilestones  Int                @default(0)
  idempotencyKey       String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  completedAt          DateTime?
  payoutInitiatedAt    DateTime?
  notifyPhone          String?
  deliveredAt          DateTime?
  otpCode              String?
  otpExpiresAt         DateTime?
  otpVerifiedAt        DateTime?
  smsDeliveryStatus    String?
  deletedByBuyer       Boolean            @default(false)
  deletedBySeller      Boolean            @default(false)
  inspectionHours      Int?
  listingId            String?
  inspectionDeadline   DateTime?
  sellerPhone          String?
  mpesaRef             String?
  b2bOriginatorId      String?
  b2cOriginatorId      String?
  auditLogs            AuditLog[]
  disputes             Dispute[]
  fraudSignals         FraudSignal[]
  milestones           Milestone[]
  notifications        Notification[]
  payouts              Payout[]
  timerJobs            TimerJob[]
  buyer                User               @relation("BuyerTransactions", fields: [buyerId], references: [id])
  listing              SecondHandListing? @relation(fields: [listingId], references: [id])
  seller               User               @relation("SellerTransactions", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([state])
  @@index([buyerId, state])
  @@index([sellerId, state])
  @@index([createdAt])
}

model FundiJob {
  id                       String                  @id @default(uuid())
  buyerId                  String
  fundiPhone               String
  amount                   Decimal                 @db.Decimal(10, 2)
  serviceFee               Decimal                 @db.Decimal(10, 2)
  totalCharged             Decimal                 @db.Decimal(10, 2)
  description              String
  durationHours            Int
  status                   FundiJobStatus          @default(PENDING_PAYMENT)
  beforePhotos             String[]
  afterPhotos              String[]
  otpHash                  String?
  otpExpiresAt             DateTime?
  otpFailedAttempts        Int                     @default(0)
  otpLockedAt              DateTime?
  acceptedAt               DateTime?
  deadlineAt               DateTime?
  completedAt              DateTime?
  inspectionDeadlineAt     DateTime?
  overdueSentAt            DateTime?
  mpesaCheckoutId          String?                 @unique
  mpesaRef                 String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  buyerPhone               String?
  extensionCount           Int                     @default(0)
  deletedAt                DateTime?
  category                 String?
  deliverables             String[]
  b2cCost                  Decimal                 @default(0) @db.Decimal(10, 2)
  originatorConversationId String?
  payoutInitiatedAt        DateTime?
  extensionRequestStatus   ExtensionRequestStatus?
  auditLogs                FundiAuditLog[]
  dispute                  FundiDispute?
  escrow                   FundiEscrow?
  extensionRequests        FundiExtensionRequest[]
  buyer                    User                    @relation("BuyerFundiJobs", fields: [buyerId], references: [id])
  fundiPayouts             FundiPayout[]
  smsReplies               FundiSmsReply[]
  notifications            Notification[]

  @@unique([buyerId, fundiPhone], map: "fundi_job_no_duplicate_pending", where: raw("(status = 'PENDING_PAYMENT'::\"FundiJobStatus\")"))
  @@index([buyerId, fundiPhone, status])
}

model FundiPayout {
  id                       String    @id @default(uuid())
  fundiJobId               String
  payoutType               String
  amount                   Decimal   @db.Decimal(10, 2)
  phone                    String
  status                   String    @default("pending")
  originatorConversationId String    @unique
  mpesaRef                 String?
  resultCode               Int?
  resultDesc               String?
  initiatedAt              DateTime  @default(now())
  completedAt              DateTime?
  failedAt                 DateTime?
  createdAt                DateTime  @default(now())
  fundiJob                 FundiJob  @relation(fields: [fundiJobId], references: [id])

  @@unique([fundiJobId, payoutType])
}

model FundiEscrow {
  id                    String    @id @default(uuid())
  jobId                 String    @unique
  amount                Decimal   @db.Decimal(10, 2)
  status                String    @default("held")
  heldAt                DateTime  @default(now())
  releasedAt            DateTime?
  refundedAt            DateTime?
  partialReleasedAmount Decimal?  @db.Decimal(10, 2)
  partialRefundAmount   Decimal?  @db.Decimal(10, 2)
  job                   FundiJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model FundiDispute {
  id             String              @id @default(uuid())
  jobId          String              @unique
  openedBy       String
  reason         String
  description    String?
  evidencePhotos String[]
  decision       FundiDisputeResult?
  refundAmount   Decimal?            @db.Decimal(10, 2)
  releaseAmount  Decimal?            @db.Decimal(10, 2)
  status         FundiDisputeStatus  @default(OPEN)
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  purpose        TransferPurpose     @default(OTHER)
  job            FundiJob            @relation(fields: [jobId], references: [id])
  opener         User                @relation("FundiDisputeOpener", fields: [openedBy], references: [id])
}

model FundiSmsReply {
  id         String    @id @default(uuid())
  jobId      String?
  phone      String
  message    String
  receivedAt DateTime  @default(now())
  processed  Boolean   @default(false)
  result     String?
  job        FundiJob? @relation(fields: [jobId], references: [id])
}

model FundiMpesaTransaction {
  id                String    @id @default(uuid())
  jobId             String    @unique
  checkoutRequestId String    @unique
  merchantRequestId String?
  amount            Decimal   @db.Decimal(10, 2)
  fee               Decimal   @db.Decimal(10, 2)
  totalCharged      Decimal   @db.Decimal(10, 2)
  phone             String
  status            String    @default("pending")
  mpesaRef          String?   @unique
  idempotencyKey    String?   @unique
  resultDesc        String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
}

model FundiAuditLog {
  id        String    @id @default(uuid())
  action    String
  jobId     String?
  userId    String?
  meta      Json?
  createdAt DateTime  @default(now())
  job       FundiJob? @relation(fields: [jobId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
}

model DeliveryOrder {
  id                   String                    @id @default(cuid())
  buyerId              String
  deliveryGuyPhone     String
  deliveryGuyName      String?
  amount               Decimal                   @db.Decimal(10, 2)
  goods                String
  address              String
  latitude             Float?
  longitude            Float?
  setDeliveryTime      DateTime
  originalDeliveryTime DateTime
  acceptedAt           DateTime?
  pickupOtpEnteredAt   DateTime?
  deliveryStartedAt    DateTime?
  receivedAt           DateTime?
  completedAt          DateTime?
  status               DeliveryStatus            @default(PENDING_PHOTO_UPLOAD)
  paymentRef           String?                   @unique
  paymentAttempts      Int                       @default(0)
  lastPaymentAttempt   DateTime?
  paymentFailureReason String?
  extensionCount       Int                       @default(0)
  totalExtendedMinutes Int                       @default(0)
  hasDispute           Boolean                   @default(false)
  disputeOpenedAt      DateTime?
  disputeResolution    String?
  adminNotesOnDispute  String?
  deliveryGuyRiskScore Int                       @default(0)
  requiresAfterPhoto   Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  mpesaCheckoutId      String?                   @unique
  mpesaRef             String?                   @unique
  productDescription   String?
  deletedAt            DateTime?
  b2cOriginatorId      String?
  dispute              DeliveryDispute?
  escrow               DeliveryEscrow?
  mpesaTx              DeliveryMpesaTransaction?
  otps                 DeliveryOTP[]
  buyer                User                      @relation("BuyerDeliveries", fields: [buyerId], references: [id], onDelete: Cascade)
  photos               DeliveryPhoto[]
  rating               DeliveryRating?
  timeline             DeliveryTimeline[]
  notifications        Notification[]

  @@index([buyerId])
  @@index([deliveryGuyPhone])
  @@index([status])
  @@index([createdAt])
  @@index([setDeliveryTime])
}

model DeliveryPhoto {
  id                 String            @id @default(cuid())
  orderId            String
  photoType          DeliveryPhotoType
  cloudinaryUrl      String
  cloudinaryPublicId String
  uploadedBy         DeliveryActorType
  uploadedAt         DateTime          @default(now())
  latitude           Float?
  longitude          Float?
  deviceId           String?
  buyerConfirmedAt   DateTime?
  comparisonScore    Float?
  fraudRiskScore     Float?
  flaggedIssues      String[]
  createdAt          DateTime          @default(now())
  photoIndex         Int               @default(0)
  order              DeliveryOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, photoType, photoIndex])
  @@index([orderId])
  @@index([photoType])
  @@index([uploadedBy])
}

model DeliveryOTP {
  id        String             @id @default(cuid())
  orderId   String
  otpType   DeliveryOTPType
  otp       String
  expiresAt DateTime
  enteredAt DateTime?
  enteredBy DeliveryActorType?
  isValid   Boolean            @default(false)
  attempts  Int                @default(0)
  createdAt DateTime           @default(now())
  order     DeliveryOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([otpType])
  @@index([expiresAt])
}

model DeliveryTimeline {
  id        String            @id @default(cuid())
  orderId   String
  event     String
  actor     DeliveryActorType
  timestamp DateTime          @default(now())
  details   String?
  createdAt DateTime          @default(now())
  order     DeliveryOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([timestamp])
  @@index([event])
}

model DeliveryDispute {
  id               String                   @id @default(cuid())
  orderId          String                   @unique
  claimerType      DeliveryActorType
  reason           String
  claimDescription String?
  cvAnalysisReport String?
  evidenceBundle   String?
  status           DeliveryDisputeStatus    @default(OPEN)
  resolution       String?
  adminAssignedTo  String?
  resolvedAt       DateTime?
  adminNotes       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  order            DeliveryOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photoComparison  DeliveryPhotoComparison?

  @@index([status])
  @@index([claimerType])
  @@index([createdAt])
}

model DeliveryPhotoComparison {
  id                  String          @id @default(cuid())
  disputeId           String          @unique
  beforePhotoUrl      String
  duringPhotoUrl      String
  afterPhotoUrl       String?
  resembleScore       Float?
  pHashDistance       Int?
  orbMatches          Int?
  clipSimilarity      Float?
  dinoV2Similarity    Float?
  tamperedScore       Float?
  substitutedScore    Float?
  damageDetected      Boolean?
  missingItemDetected Boolean?
  finalVerdict        String?
  confidence          Float?
  createdAt           DateTime        @default(now())
  dispute             DeliveryDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

model DeliveryGuyRiskProfile {
  id               String            @id @default(cuid())
  phone            String            @unique
  totalDisputes    Int               @default(0)
  minorDisputes    Int               @default(0)
  refundDisputes   Int               @default(0)
  fraudConfirmed   Int               @default(0)
  riskScore        Int               @default(0)
  riskLevel        DeliveryRiskLevel @default(LOW)
  lastDisputeAt    DateTime?
  cautiondedAt     DateTime?
  flaggedForReview Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([riskScore])
  @@index([riskLevel])
  @@index([phone])
}

model DeliveryPaymentRetryLog {
  id                String    @id @default(cuid())
  orderId           String
  attempt           Int
  reason            String
  mpesaResponseCode String?
  mpesaResponseDesc String?
  nextRetryAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model DeliveryEvidenceBundle {
  id               String   @id @default(cuid())
  disputeId        String   @unique
  beforePhoto      String
  duringPhoto      String
  afterPhoto       String?
  photoComparison  String
  cvAnalysisReport String
  timeline         String
  gpsData          String
  otpLogs          String
  smsSentLogs      String
  paymentLogs      String
  generatedAt      DateTime @default(now())

  @@index([disputeId])
}

model DeliveryRating {
  id      String        @id @default(cuid())
  orderId String        @unique
  rating  Int
  review  String?
  ratedAt DateTime      @default(now())
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryMpesaTransaction {
  id                String        @id @default(cuid())
  orderId           String        @unique
  checkoutRequestId String        @unique
  merchantRequestId String?
  amount            Decimal       @db.Decimal(10, 2)
  fee               Decimal       @db.Decimal(10, 2)
  totalCharged      Decimal       @db.Decimal(10, 2)
  phone             String
  status            String        @default("pending")
  mpesaRef          String?       @unique
  resultDesc        String?
